# Copiar a ~/.env.global y ajustar.
# Permisos: chmod 600 ~/.env.global
# Cargado por systemd vía EnvironmentFile=. NUNCA commitear.

# Plugins de chat (uno por bot que tengas activo)
TELEGRAM_BOT_TOKEN=""
DISCORD_BOT_TOKEN=""

# Claude — solo si vas a usar API key además de OAuth (no es necesario para Claude Code)
ANTHROPIC_API_KEY=""

# APIs externas opcionales
ELEVENLABS_API_KEY=""
REPLICATE_API_TOKEN=""

# GitHub PAT — solo si registras un MCP local de GitHub
GITHUB_PAT=""
